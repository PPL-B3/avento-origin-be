// learn more about it in the docs: https://pris.ly/d/prisma-schema.

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  @@map("messages")
}

model User {
  id         String @id @default(uuid())
  email      String @unique
  password   String
  role       String
  lastLogout BigInt

  auditLogs AuditLog[] // Tambahkan ini untuk melengkapi relasi

  @@map("users")
}

model Document {
  documentID   String     @id @default(uuid())
  documentName String
  filePath     String
  uploadDate   DateTime   @default(now())
  ownerName    String
  AuditLog     AuditLog[]
}

model AuditLog {
  logID      String    @id @default(uuid())
  eventType  String
  timestamp  DateTime  @default(now())
  user       User      @relation(fields: [userID], references: [id])
  userID     String
  document   Document? @relation(fields: [documentID], references: [documentID])
  documentID String? // Opsional karena tidak semua event terkait dokumen
  details    String

  @@map("audit_logs")
}
